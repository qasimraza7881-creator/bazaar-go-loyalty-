rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /business-logos/{businessId}/{fileName} {
      // Anyone can view a shop's logo (it's shown on public loyalty cards).
      allow read: if true;
      // Only a signed-in user who owns this businessId (checked against
      // their Firestore user doc) can upload/replace its logo.
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.businessId == businessId &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
